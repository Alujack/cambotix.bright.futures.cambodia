# Admin panel. Leave unset (or false) on Vercel: the website then serves the
# content defined in code and every /admin address returns 404. Set it to true
# only on a host with one always-on instance and a writable disk.
CMS_ENABLED=false
# SQLite requires persistent, writable storage (one application instance).
DATABASE_PATH=./data/site.sqlite
# Set the public HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: create the first admin without prompts, then remove these lines.
# ADMIN_EMAIL=admin@example.org
# ADMIN_PASSWORD=change-this-to-at-least-12-characters
